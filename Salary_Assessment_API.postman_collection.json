{
  "info": {
    "_postman_id": "salary-assessment-api-collection",
    "name": "Salary Assessment API",
    "description": "Collection of endpoints to test the Employee Management & Salary Insights backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Employee CRUD",
      "item": [
        {
          "name": "List Employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/employees?page=1&limit=20&search=&department=&country=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "search",
                  "value": ""
                },
                {
                  "key": "department",
                  "value": ""
                },
                {
                  "key": "country",
                  "value": ""
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson && responseJson.id) {",
                  "    pm.collectionVariables.set(\"employee_id\", responseJson.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"jobTitle\": \"Software Engineer\",\n  \"country\": \"USA\",\n  \"salary\": 110000,\n  \"department\": \"Engineering\",\n  \"email\": \"jane.doe.postman@company.com\",\n  \"employmentType\": \"Full-time\",\n  \"gender\": \"Female\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"jobTitle\": \"Senior Software Engineer\",\n  \"country\": \"USA\",\n  \"salary\": 135000,\n  \"department\": \"Engineering\",\n  \"email\": \"jane.doe.postman@company.com\",\n  \"employmentType\": \"Full-time\",\n  \"gender\": \"Female\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employee_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/employees/{{employee_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "employees",
                "{{employee_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Salary Insights",
      "item": [
        {
          "name": "Country Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/insights/country-stats",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "insights",
                "country-stats"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Job Title Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/insights/job-title-stats?country=USA",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "insights",
                "job-title-stats"
              ],
              "query": [
                {
                  "key": "country",
                  "value": "USA"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/insights/dashboard-summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "insights",
                "dashboard-summary"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "employee_id",
      "value": "",
      "type": "string"
    }
  ]
}
